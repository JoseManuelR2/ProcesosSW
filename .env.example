# Puerto del servidor. Cloud Run lo inyecta automáticamente.
PORT=3000

# URL pública de la aplicación (sin barra final). En local se deja vacía y se usa
# http://localhost:PORT. En Cloud Run la fija el propio despliegue.
BASE_URL=

# Cadena de conexión a MongoDB (Atlas). Si se omite, se usa una CAD en memoria.
MONGODB_URI=

# Secreto con el que se firma la cookie de sesión. Obligatorio en producción.
SESSION_SECRET=

# Primer administrador: se crea automáticamente al arrancar si no existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Inicio de sesión con GitHub (OAuth App). La URL de retorno debe ser
# http://localhost:3000/auth/github/callback en local.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Envío del correo de confirmación por SMTP. Si SMTP_HOST se deja vacío, en local
# el enlace se escribe en la consola del servidor en lugar de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# "production" activa cookies seguras (requiere HTTPS) y exige SESSION_SECRET y SMTP_HOST.
NODE_ENV=development
